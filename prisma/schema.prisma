// Prisma schema — PostgreSQL (Neon / Supabase / Vercel Postgres)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Guestbook {
  id      String   @id @default(uuid())
  name    String
  message String
  date    DateTime @default(now())
}
